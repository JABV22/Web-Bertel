# ============================================================
# PLATAFORMA BERTEL — Variables de entorno (PLANTILLA)
# ------------------------------------------------------------
# Copia este archivo como `.env.local` y rellena los valores reales.
#
#   cp .env.example .env.local
#
# `.env.local` está ignorado por Git y NUNCA debe subirse.
# Este archivo solo contiene nombres y valores ficticios.
#
# ARCHITECTURE.md §62-§63 · DATABASE.md §52
# ============================================================


# ------------------------------------------------------------
# Supabase — necesario a partir de la Fase 2
# ------------------------------------------------------------
# Se obtienen en: Supabase → tu proyecto → Project Settings → API

# URL del proyecto. Es pública: viaja al navegador.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Clave anónima. Es pública por diseño: la seguridad real la dan las
# políticas RLS de la base de datos (DATABASE.md §59-§66), no esta clave.
NEXT_PUBLIC_SUPABASE_ANON_KEY=clave_anonima_ficticia_reemplazar

# ------------------------------------------------------------
# SECRETO — nunca en el cliente
# ------------------------------------------------------------
# ARCHITECTURE.md §63: la clave privilegiada existe SOLO en servidor.
# Nunca en el navegador, en GitHub, en capturas ni en documentación.
# Salta todas las políticas RLS: trátala como una contraseña maestra.
# No lleva el prefijo NEXT_PUBLIC_ precisamente para que Next.js no la exponga.
SUPABASE_SERVICE_ROLE_KEY=clave_service_role_ficticia_reemplazar


# ------------------------------------------------------------
# Aplicación
# ------------------------------------------------------------
# URL base del entorno. En producción: https://www.preicfesbertel.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Identifica el entorno (ARCHITECTURE.md §61): development | staging | production
NEXT_PUBLIC_ENTORNO=development
